
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Preserving Ancestral Heritage | Syed Amjad Hussain</title>
  <meta name="description" content="The initiative of Syed Amjad Hussain to protect and demarcate the land associated with the shrine of Hazrat Syed Ahmad Jajneri at Nadiawan, Bihar.">
  <meta name="theme-color" content="#641f32">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --burgundy: #641f32;
      --burgundy-dark: #35131e;
      --burgundy-light: #82364b;
      --gold: #b89558;
      --gold-light: #e1cca2;
      --ivory: #f8f5ee;
      --paper: #fffdf8;
      --ink: #292421;
      --muted: #746c65;
      --line: #e7dfd2;
      --white: #fff;
      --shadow: 0 14px 40px rgba(49, 28, 24, .08);
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 95px;
    }

    body {
      font-family: "DM Sans", sans-serif;
      background: var(--ivory);
      color: var(--ink);
      line-height: 1.8;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1160px, 91%);
      margin-inline: auto;
    }

    .serif {
      font-family: "Playfair Display", serif;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 1px;
      background: currentColor;
    }

    .section-heading {
      max-width: 770px;
      margin-bottom: 36px;
    }

    .section-heading h2 {
      font: 600 clamp(2rem, 4.3vw, 3.05rem)/1.2 "Playfair Display", serif;
      color: var(--burgundy-dark);
      margin: 13px 0 17px;
    }

    .section-heading p {
      color: var(--muted);
    }

    /* Navigation */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 253, 248, .96);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      min-height: 82px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 22px;
    }

    .brand {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      line-height: 1.3;
    }

    .brand strong {
      font: 700 1.2rem "Playfair Display", serif;
      color: var(--burgundy);
    }

    .brand span {
      margin-top: 4px;
      color: var(--muted);
      font-size: .66rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .nav-links a {
      font-size: .76rem;
      font-weight: 600;
      color: #49413e;
      transition: color .2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--burgundy);
    }

    .nav-links .contact-link {
      padding: 10px 14px;
      background: var(--burgundy);
      color: var(--white);
      border-radius: 7px;
    }

    .nav-links .contact-link:hover {
      background: var(--burgundy-dark);
      color: var(--white);
    }

    .menu-toggle {
      display: none;
      padding: 8px 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: transparent;
      color: var(--burgundy);
      cursor: pointer;
    }

    /* Hero */

    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 83px 0 76px;
      color: var(--white);
      background:
        radial-gradient(ellipse at 86% 14%, rgba(184,149,88,.22), transparent 34%),
        linear-gradient(125deg, #30101a, #641f32 60%, #793348);
    }

    .hero::before,
    .hero::after {
      position: absolute;
      z-index: -1;
      content: "";
      border: 1px solid rgba(225,204,162,.24);
      border-radius: 50%;
      pointer-events: none;
    }

    .hero::before {
      width: 460px;
      height: 460px;
      right: -135px;
      top: -150px;
    }

    .hero::after {
      width: 325px;
      height: 325px;
      right: -65px;
      top: -82px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.12fr .88fr;
      align-items: center;
      gap: 58px;
    }

    .hero .eyebrow {
      color: var(--gold-light);
    }

    .hero h1 {
      max-width: 760px;
      margin: 23px 0 20px;
      font: 600 clamp(2.7rem, 5.5vw, 4.65rem)/1.12 "Playfair Display", serif;
      letter-spacing: -.9px;
    }

    .hero h1 span {
      display: block;
      color: var(--gold-light);
    }

    .hero-subtitle {
      max-width: 590px;
      font: 500 clamp(1.15rem, 2.1vw, 1.55rem)/1.5 "Playfair Display", serif;
      color: #f0e3d0;
      margin-bottom: 20px;
    }

    .hero-description {
      max-width: 630px;
      color: #e6d8d9;
      font-size: .96rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 12px 19px;
      border-radius: 7px;
      font-size: .85rem;
      font-weight: 700;
      transition: .2s ease;
    }

    .btn-gold {
      background: var(--gold);
      color: #261b13;
    }

    .btn-gold:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
    }

    .btn-outline {
      color: var(--white);
      border: 1px solid rgba(255,255,255,.4);
    }

    .btn-outline:hover {
      background: rgba(255,255,255,.08);
    }

    .hero-note {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,.17);
      color: #d4c2c5;
      font-size: .8rem;
    }

    /* Hero heritage illustration */

    .heritage-art {
      position: relative;
      min-height: 385px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .art-frame {
      width: min(390px, 100%);
      aspect-ratio: 4 / 4.4;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(225,204,162,.55);
      border-radius: 190px 190px 14px 14px;
      background:
        radial-gradient(ellipse at 50% 34%, rgba(225,204,162,.17), transparent 39%),
        linear-gradient(160deg, #81513c, #4a202d 70%, #35131e);
      box-shadow: 0 28px 55px rgba(0,0,0,.24);
    }

    .art-inner {
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(225,204,162,.34);
      border-radius: 180px 180px 8px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 25px;
    }

    .art-star {
      color: var(--gold-light);
      font-size: 2.8rem;
      line-height: 1;
      margin-bottom: 23px;
    }

    .art-kicker {
      color: var(--gold-light);
      font-size: .63rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .art-title {
      color: #fff6e8;
      font: 600 clamp(1.5rem, 2.8vw, 2.1rem)/1.25 "Playfair Display", serif;
      margin: 17px 0;
    }

    .art-rule {
      width: 57px;
      height: 1px;
      background: var(--gold-light);
      margin-bottom: 17px;
    }

    .art-place {
      color: #e8d9cb;
      font-size: .8rem;
    }

    .art-caption {
      position: absolute;
      bottom: -2px;
      left: 0;
      right: 0;
      text-align: center;
      color: #dbc9ca;
      font-size: .75rem;
    }

    /* Introduction */

    .intro-section {
      padding: 83px 0;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1.13fr .87fr;
      gap: 50px;
      align-items: start;
    }

    .intro-copy h2 {
      font: 600 clamp(2rem, 4vw, 2.85rem)/1.2 "Playfair Display", serif;
      color: var(--burgundy-dark);
      margin: 14px 0 22px;
    }

    .intro-copy p {
      color: #625a53;
      margin-bottom: 17px;
    }

    .intro-copy strong {
      color: var(--burgundy);
    }

    .ancestry-panel {
      padding: 30px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .panel-symbol {
      color: var(--gold);
      font: 3.6rem/1 "Playfair Display", serif;
    }

    .ancestry-panel h3 {
      color: var(--burgundy-dark);
      font: 600 1.55rem/1.3 "Playfair Display", serif;
      margin: 17px 0 12px;
    }

    .ancestry-panel p {
      color: var(--muted);
      font-size: .91rem;
    }

    .location-label {
      display: block;
      margin-top: 22px;
      padding-top: 17px;
      border-top: 1px solid var(--line);
      color: var(--burgundy);
      font-size: .79rem;
      font-weight: 700;
      letter-spacing: .4px;
    }

    /* Timeline */

    .timeline-section {
      padding: 83px 0;
      background: var(--paper);
      border-block: 1px solid var(--line);
    }

    .timeline {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
    }

    .timeline::before {
      content: "";
      position: absolute;
      left: 22px;
      top: 9px;
      bottom: 10px;
      width: 1px;
      background: #d9c6a6;
    }

    .timeline-item {
      position: relative;
      padding: 0 0 36px 65px;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    .timeline-dot {
      position: absolute;
      left: 13px;
      top: 5px;
      width: 19px;
      height: 19px;
      border: 4px solid var(--paper);
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 0 1px var(--gold);
    }

    .timeline-date {
      color: var(--burgundy);
      font-size: .76rem;
      font-weight: 700;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    .timeline-item h3 {
      color: var(--burgundy-dark);
      font: 600 1.55rem/1.35 "Playfair Display", serif;
      margin: 8px 0 10px;
    }

    .timeline-item p {
      color: #625a53;
    }

    /* Collective effort */

    .community-section {
      padding: 84px 0;
    }

    .community-intro {
      max-width: 820px;
      color: #625a53;
      margin-bottom: 33px;
    }

    .community-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 21px;
    }

    .community-card {
      padding: 28px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 13px;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .community-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
    }

    .community-card .card-kicker {
      color: var(--gold);
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .community-card h3 {
      color: var(--burgundy-dark);
      font: 600 1.45rem/1.35 "Playfair Display", serif;
      margin: 11px 0 13px;
    }

    .community-card p {
      color: var(--muted);
      font-size: .91rem;
    }

    .community-note {
      margin-top: 25px;
      padding: 23px 26px;
      background: rgba(184,149,88,.11);
      border-left: 3px solid var(--gold);
      color: #5d5145;
      font: 500 1.2rem/1.65 "Playfair Display", serif;
    }

    /* Documents */

    .records-section {
      padding: 80px 0;
      background: #eee6d9;
    }

    .records-panel {
      display: grid;
      grid-template-columns: .82fr 1.18fr;
      overflow: hidden;
      border-radius: var(--radius);
      background: var(--paper);
      border: 1px solid #e0d4c2;
    }

    .records-heading {
      padding: 36px;
      color: var(--white);
      background:
        radial-gradient(ellipse at 100% 0%, rgba(225,204,162,.2), transparent 35%),
        linear-gradient(145deg, #733047, #3c111d);
    }

    .records-heading .eyebrow {
      color: var(--gold-light);
    }

    .records-heading h2 {
      font: 600 2.15rem/1.2 "Playfair Display", serif;
      margin: 15px 0;
    }

    .records-heading p {
      color: #e3d2d5;
      font-size: .9rem;
    }

    .records-copy {
      padding: 36px;
      align-self: center;
    }

    .records-copy p {
      color: #625a53;
      margin-bottom: 16px;
    }

    .records-status {
      display: inline-block;
      padding: 7px 12px;
      border: 1px solid #d8c5a1;
      border-radius: 30px;
      color: var(--burgundy);
      background: #f7f0e3;
      font-size: .77rem;
      font-weight: 700;
      margin-bottom: 16px;
    }

    /* Principles */

    .principles-section {
      padding: 84px 0;
    }

    .principles-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .principle-card {
      padding: 25px;
      border-top: 2px solid var(--gold);
      background: var(--paper);
      box-shadow: 0 5px 24px rgba(49,28,24,.04);
    }

    .principle-card h3 {
      color: var(--burgundy-dark);
      font: 600 1.3rem "Playfair Display", serif;
      margin-bottom: 10px;
    }

    .principle-card p {
      color: var(--muted);
      font-size: .89rem;
    }

    /* Closing */

    .closing-section {
      padding: 0 0 82px;
    }

    .closing-box {
      padding: clamp(30px, 5.2vw, 58px);
      border-radius: var(--radius);
      color: var(--white);
      background:
        radial-gradient(ellipse at 95% 0%, rgba(184,149,88,.19), transparent 35%),
        linear-gradient(125deg, #35131e, #641f32);
    }

    .closing-box .eyebrow {
      color: var(--gold-light);
    }

    .closing-box h2 {
      max-width: 850px;
      font: 600 clamp(2.1rem, 4.8vw, 3.4rem)/1.17 "Playfair Display", serif;
      margin: 17px 0 21px;
    }

    .closing-box p {
      max-width: 850px;
      color: #e5d5d7;
      margin-bottom: 16px;
    }

    .closing-quote {
      max-width: 800px;
      padding: 20px 23px;
      margin: 27px 0;
      border-left: 3px solid var(--gold);
      background: rgba(255,255,255,.055);
      color: var(--gold-light);
      font: 500 clamp(1.3rem, 2.7vw, 1.8rem)/1.5 "Playfair Display", serif;
    }

    .prayer-note {
      color: #f0e2ce !important;
      font-style: italic;
    }

    /* Footer */

    .site-footer {
      padding: 47px 0 23px;
      background: #29141a;
      color: #eee3df;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr .8fr;
      gap: 38px;
      padding-bottom: 34px;
    }

    .footer-brand {
      font: 600 1.45rem "Playfair Display", serif;
      color: var(--gold-light);
      margin-bottom: 13px;
    }

    .footer-about {
      max-width: 390px;
      color: #c8b9b7;
      font-size: .86rem;
    }

    .footer-col h3 {
      color: var(--gold-light);
      font-size: .82rem;
      text-transform: uppercase;
      letter-spacing: 1.3px;
      margin-bottom: 14px;
    }

    .footer-links {
      display: grid;
      gap: 8px;
    }

    .footer-links a {
      color: #d7c9c6;
      font-size: .84rem;
    }

    .footer-links a:hover {
      color: var(--gold-light);
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.13);
      color: #b9a8a7;
      font-size: .75rem;
    }

    @media (max-width: 1100px) {
      .nav-links {
        gap: 9px;
      }

      .nav-links a {
        font-size: .69rem;
      }

      .hero-grid {
        gap: 35px;
      }
    }

    @media (max-width: 800px) {
      .nav {
        min-height: 73px;
      }

      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 72px;
        left: 0;
        right: 0;
        padding: 17px 5%;
        background: var(--paper);
        border-bottom: 1px solid var(--line);
        box-shadow: 0 15px 25px rgba(0,0,0,.07);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 10px 0;
        font-size: .87rem;
      }

      .nav-links .contact-link {
        text-align: center;
        margin-top: 8px;
      }

      .hero {
        padding: 65px 0;
      }

      .hero-grid,
      .intro-grid,
      .records-panel {
        grid-template-columns: 1fr;
      }

      .hero-grid {
        gap: 18px;
      }

      .heritage-art {
        min-height: 380px;
      }

      .community-grid {
        grid-template-columns: 1fr;
      }

      .principles-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .intro-section,
      .timeline-section,
      .community-section,
      .records-section,
      .principles-section {
        padding: 65px 0;
      }

      .closing-section {
        padding-bottom: 65px;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-grid > :first-child {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 540px) {
      .container {
        width: 90%;
      }

      .brand strong {
        font-size: 1.05rem;
      }

      .brand span {
        font-size: .56rem;
      }

      .hero h1 {
        font-size: 2.65rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .principles-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid > :first-child {
        grid-column: auto;
      }

      .timeline-item {
        padding-left: 49px;
      }

      .timeline::before {
        left: 16px;
      }

      .timeline-dot {
        left: 7px;
      }

      .records-heading,
      .records-copy {
        padding: 27px;
      }

      .heritage-art {
        min-height: 330px;
      }

      .art-frame {
        width: min(310px, 100%);
      }

      .footer-bottom {
        flex-direction: column;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <header class="site-header">
    <div class="container nav">

      <a href="home.html" class="brand" aria-label="Syed Amjad Hussain home">
        <strong>Syed Amjad Hussain</strong>
