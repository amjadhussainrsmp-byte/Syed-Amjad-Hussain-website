      >☰ Menu</button>

      <nav class="nav-links" id="navLinks" aria-label="Main navigation">
        <a href="home.html">Home</a>
        <a href="biography.html">Biography</a>
        <a href="bihar-aur-sufivad.html">Bihar Aur Sufivad</a>
        <a href="sufi-heritage.html">The Sufi Heritage of Bihar</a>
        <a href="research.html">Research</a>
        <a href="poetry.html">Poetry</a>
        <a href="social-work.html">Social Work</a>
        <a href="awards-honours.html">Awards & Honours</a>
        <a href="ancestral-heritage.html" class="active">Ancestral Heritage</a>
        <a href="contact.html" class="contact-link">Contact</a>
      </nav>

    </div>
  </header>

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container hero-grid">

        <div>
          <span class="eyebrow">Heritage · Memory · Responsibility</span>

          <h1>
            Preserving
            <span>Ancestral Heritage</span>
          </h1>

          <p class="hero-subtitle">
            A personal journey to protect the resting place of an ancestor.
          </p>

          <p class="hero-description">
            The story of Syed Amjad Hussain's initiative to draw attention
            to the protection and boundary demarcation of the shrine of
            Hazrat Syed Ahmad Jajneri (Rahmatullahi Ta’ala Alaih) at
            Nadiawan village, Lakhisarai district, Bihar.
          </p>

          <div class="hero-actions">
            <a href="#the-initiative" class="btn btn-gold">Explore the Initiative ↓</a>
            <a href="#timeline" class="btn btn-outline">Read the Timeline</a>
          </div>

          <p class="hero-note">
            An ongoing effort rooted in ancestral memory and collective responsibility.
          </p>
        </div>

        <div class="heritage-art">
          <div class="art-frame" role="img"
            aria-label="Decorative heritage illustration representing remembrance and preservation">
            <div class="art-inner">
              <div class="art-star" aria-hidden="true">✧</div>
              <div class="art-kicker">Ancestral Heritage</div>
